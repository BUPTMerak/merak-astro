---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const SITE_NAME = "Merak";
const defaults = {
  title: "Merak \u2014 Building Things for the Web",
  description:
    "A retro-terminal portfolio. I build things for the web \u2014 interfaces, tools, and experiments that feel alive.",
  image: "/favicon.png",
};

const { title = defaults.title, description = defaults.description, image = defaults.image } =
  Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const resolvedImage = new URL(image, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="en" class="m-0 h-full w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:site_name" content={SITE_NAME} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />

    <!-- Theme -->
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f4f6" media="(prefers-color-scheme: light)" />
  </head>
  <body class="m-0 h-full w-full bg-gray-100 dark:bg-black">
    <slot />
  </body>
</html>
