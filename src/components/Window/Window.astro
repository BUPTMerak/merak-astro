---
import { cn } from "@/lib/utils";
import CloseIcon from "./CloseIcon.svg";
import MaximizeIcon from "./MaximizeIcon.svg";
import MinimizeIcon from "./MinimizeIcon.svg";

export interface Props {
  title?: string;
  class?: string;
  id?: string;
}

const { title = "Window", class: className = "", id } = Astro.props;
---

<div
  data-window
  {...(id ? { "data-window-id": id } : {})}
  class={cn(
    "h-full bg-win-surface border-2 border-win-surface win31-outset flex flex-col",
    className,
  )}
>
  <div
    data-window-titlebar
    class="flex items-center justify-between border-b border-gray-500 bg-linear-to-r from-blue-600 to-blue-800 px-0.5 py-0.5 text-[11px] font-bold text-white md:text-[10px] dark:border-gray-600 dark:from-blue-800 dark:to-blue-900"
  >
    <div class="grow px-1.5 py-0.5" data-window-title>{title}</div>
    <div class="flex gap-0.5">
      <button
        class="win31-button-outset active:win31-button-inset flex h-3.5 w-4 cursor-pointer items-center justify-center bg-win-surface p-0 text-[8px] font-bold text-win-text hover:bg-win-surface-hover"
        aria-label="Minimize"
      >
        <MinimizeIcon />
      </button>
      <button
        class="win31-button-outset active:win31-button-inset flex h-3.5 w-4 cursor-pointer items-center justify-center bg-win-surface p-0 text-[8px] font-bold text-win-text hover:bg-win-surface-hover"
        aria-label="Maximize"
      >
        <MaximizeIcon />
      </button>
      <button
        data-window-close
        class="win31-button-outset active:win31-button-inset flex h-3.5 w-4 cursor-pointer items-center justify-center bg-win-surface p-0 text-[8px] font-bold text-win-text hover:bg-win-surface-hover"
        aria-label="Close"
      >
        <CloseIcon />
      </button>
    </div>
  </div>

  <div class="relative grow overflow-hidden">
    <slot />
    <div
      data-window-resize
      class="absolute right-0 bottom-0 z-10 h-3 w-3 cursor-se-resize"
      aria-hidden="true"
    >
      <svg viewBox="0 0 12 12" class="h-full w-full">
        <line x1="10" y1="2" x2="2" y2="10" stroke="#808080" stroke-width="1"></line>
        <line x1="10" y1="5" x2="5" y2="10" stroke="#808080" stroke-width="1"></line>
        <line x1="10" y1="8" x2="8" y2="10" stroke="#808080" stroke-width="1"></line>
        <line x1="11" y1="2" x2="2" y2="11" stroke="#fff" stroke-width="1"></line>
        <line x1="11" y1="5" x2="5" y2="11" stroke="#fff" stroke-width="1"></line>
        <line x1="11" y1="8" x2="8" y2="11" stroke="#fff" stroke-width="1"></line>
      </svg>
    </div>
  </div>
</div>
