---
import sphereWide from "@/assets/sphere_wide.png";
import { cn } from "@/lib/utils";
import { WireframeBox } from "./WireframeBox.tsx";
---

<!--
  CRT curvature is split across two layers.

  The backdrop keeps the real feImage/feDisplacementMap warp (wireframe room,
  grid, glass shading). feDisplacementMap is paint-time only, so it cannot be
  applied to interactive DOM without moving the hit boxes away from the pixels.

  Windows therefore get the local linearisation of the same displacement field
  as a CSS matrix(...) — see src/scripts/crt-warp.ts. Browsers hit-test
  transforms, so the window is painted on the glass and clicked exactly where
  it is painted. An affine transform cannot reproduce the second-order bow
  inside a window (1-4px over ~500px); everything else (translation, scale,
  shear) matches the filter field.
-->
<div
  class={cn(
    "crt relative isolate overflow-hidden border",
    "shadow-[inset_0_0_40px_rgba(0,0,0,0.3)] dark:shadow-[inset_0_0_40px_rgba(0,0,0,0.9)] bg-gray-100/90 dark:bg-black/90",
    Astro.props.class,
  )}
>
  <div class="pointer-events-none absolute -top-9999 z-0 hidden">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      width="0"
      height="0"
    >
      <defs>
        <filter
          id="SphereMapTest"
          filterUnits="objectBoundingBox"
          x="-0.45"
          y="-1.29"
          width="1.6"
          height="3.5"
        >
          <feImage result="map" xlink:href={sphereWide.src}></feImage>
          <feDisplacementMap
            in="SourceGraphic"
            in2="map"
            scale="100"
            xChannelSelector="R"
            yChannelSelector="G"></feDisplacementMap>
        </filter>
      </defs>
    </svg>
  </div>
  <div class="crt-warp pointer-events-none absolute inset-0">
    <WireframeBox client:only="react" className="opacity-80" />
  </div>
  <div class="crt-vignette pointer-events-none absolute inset-0"></div>
  <div class="crt-curvature pointer-events-none absolute inset-0"></div>
  <div
    class="crt-content relative z-1 h-full text-gray-800 selection:bg-gray-300/60 selection:text-gray-900 dark:text-emerald-400 dark:selection:bg-emerald-900/60 dark:selection:text-emerald-200"
  >
    <div class="crt-curve h-full w-full">
      <slot />
    </div>
  </div>
</div>
<style>
  .crt {
    background-image: radial-gradient(120% 140% at 50% 50%, rgba(100, 100, 100, 0.3), #f5f5f5 85%);
  }

  @media (prefers-color-scheme: dark) {
    .crt {
      background-image: radial-gradient(120% 140% at 50% 50%, rgba(0, 40, 0, 0.55), #000 85%);
    }
  }
  .crt-warp {
    /* The gradient must live inside the filtered layer: the displacement map
       samples the source at its edges, and a transparent backdrop there makes
       the warp fade out instead of bending the glass darkness. */
    background-image: radial-gradient(120% 140% at 50% 50%, rgba(100, 100, 100, 0.3), #f5f5f5 85%);
    filter: url(#SphereMapTest);
  }

  @media (prefers-color-scheme: dark) {
    .crt-warp {
      background-image: radial-gradient(120% 140% at 50% 50%, rgba(0, 40, 0, 0.55), #000 85%);
    }
  }
  .crt::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      0deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(255, 255, 255, 0.18) 10%,
      rgba(0, 0, 0, 0.15) 100%
    );
    opacity: 0.08;
    animation: scanline-move 8s linear infinite;
    z-index: 2;
  }
  .crt::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, 0.35) 51%);
    background-size: 100% 3px;
    opacity: 0.6;
    z-index: 2;
    animation: scanlines-crt steps(60) 1s infinite;
  }
  .crt-curvature {
    background:
      radial-gradient(
        125% 160% at 50% 45%,
        rgba(255, 255, 255, 0.06),
        rgba(255, 255, 255, 0.02) 35%,
        rgba(0, 0, 0, 0) 55%
      ),
      radial-gradient(140% 185% at 50% 55%, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.35) 100%);
    mix-blend-mode: screen;
    z-index: 2;
  }
  .crt-vignette {
    box-shadow: inset 0 0 120px 40px rgba(0, 0, 0, 0.3);
    z-index: 2;
  }

  @media (prefers-color-scheme: dark) {
    .crt-vignette {
      box-shadow: inset 0 0 120px 40px rgba(0, 0, 0, 0.9);
    }
  }
  .crt-content {
    filter: contrast(1.05) brightness(1.1) saturate(0.8);
    text-shadow: 0 0 2px rgba(100, 100, 100, 0.2);
  }

  @media (prefers-color-scheme: dark) {
    .crt-content {
      filter: contrast(1.15) brightness(0.92) saturate(0.9);
      text-shadow: 0 0 6px rgba(32, 200, 120, 0.35);
    }
  }
  .crt-curve {
    /* A uniform perspective is hit-test safe (the browser maps pointer
       coordinates through CSS transforms), unlike an SVG displacement map. */
    transform: perspective(1200px) translateZ(50px);
    transform-origin: center;
    will-change: transform;
    -webkit-mask-image: radial-gradient(
      120% 180% at 50% 48%,
      rgba(0, 0, 0, 1) 70%,
      rgba(0, 0, 0, 0.9) 80%,
      rgba(0, 0, 0, 0) 100%
    );
    mask-image: radial-gradient(
      120% 180% at 50% 48%,
      rgba(0, 0, 0, 1) 70%,
      rgba(0, 0, 0, 0.9) 80%,
      rgba(0, 0, 0, 0) 100%
    );
  }
  @media (max-width: 1200px) {
    .crt-warp {
      filter: none;
    }
    .crt-curvature {
      display: none;
    }
    .crt-curve {
      transform: none;
      will-change: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  @keyframes scanline-move {
    0% {
      transform: translate3d(0, -100%, 0);
    }
    85% {
      transform: translate3d(0, -100%, 0);
    }
    100% {
      transform: translate3d(0, 0%, 0);
    }
  }
  @keyframes scanlines-crt {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 0 3px;
    }
  }
</style>
