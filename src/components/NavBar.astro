---
import Window from "./Window/Window.astro";
---

<Window title="C:\\NAV.EXE" id="nav">
  <div
    class="flex items-center gap-1 bg-white px-2 py-1.5 sm:gap-0.5 sm:px-1 sm:py-1 dark:bg-black"
  >
    <a
      href="/"
      class="win31-button-outset dark:win31-button-outset-dark active:win31-button-inset dark:active:win31-button-inset-dark inline-block cursor-pointer bg-[#c0c0c0] px-3 py-0.5 text-xs font-bold text-black no-underline hover:bg-[#d4d0c8] sm:px-2 sm:text-[10px] dark:bg-[#505050] dark:text-white dark:hover:bg-[#606060]"
    >
      Home
    </a>
    <button
      type="button"
      data-open-window="about"
      class="win31-button-outset dark:win31-button-outset-dark active:win31-button-inset dark:active:win31-button-inset-dark inline-block cursor-pointer bg-[#c0c0c0] px-3 py-0.5 text-xs font-bold text-black hover:bg-[#d4d0c8] sm:px-2 sm:text-[10px] dark:bg-[#505050] dark:text-white dark:hover:bg-[#606060]"
    >
      About
    </button>
    <button
      type="button"
      data-open-window="projects"
      class="win31-button-outset dark:win31-button-outset-dark active:win31-button-inset dark:active:win31-button-inset-dark inline-block cursor-pointer bg-[#c0c0c0] px-3 py-0.5 text-xs font-bold text-black hover:bg-[#d4d0c8] sm:px-2 sm:text-[10px] dark:bg-[#505050] dark:text-white dark:hover:bg-[#606060]"
    >
      Projects
    </button>
    <button
      type="button"
      data-open-window="contact"
      class="win31-button-outset dark:win31-button-outset-dark active:win31-button-inset dark:active:win31-button-inset-dark inline-block cursor-pointer bg-[#c0c0c0] px-3 py-0.5 text-xs font-bold text-black hover:bg-[#d4d0c8] sm:px-2 sm:text-[10px] dark:bg-[#505050] dark:text-white dark:hover:bg-[#606060]"
    >
      Contact
    </button>
  </div>
</Window>
