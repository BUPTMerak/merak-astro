---
import Window from "./Window/Window.astro";

const icp = import.meta.env.PUBLIC_ICP;
---

<Window title="C:\\NAV.EXE" id="nav">
  <div
    class="flex items-center gap-1 bg-white px-2 py-1.5 sm:gap-0.5 sm:px-1 sm:py-1 dark:bg-black"
  >
    <a
      href="/"
      class="win31-button-outset active:win31-button-inset inline-block cursor-pointer bg-win-surface px-3 py-0.5 text-xs font-bold text-win-text no-underline hover:bg-win-surface-hover sm:px-2 sm:text-[10px]"
    >
      Home
    </a>
    <button
      type="button"
      data-open-window="about"
      class="win31-button-outset active:win31-button-inset inline-block cursor-pointer bg-win-surface px-3 py-0.5 text-xs font-bold text-win-text hover:bg-win-surface-hover sm:px-2 sm:text-[10px]"
    >
      About
    </button>
    <button
      type="button"
      data-open-window="projects"
      class="win31-button-outset active:win31-button-inset inline-block cursor-pointer bg-win-surface px-3 py-0.5 text-xs font-bold text-win-text hover:bg-win-surface-hover sm:px-2 sm:text-[10px]"
    >
      Projects
    </button>
    <button
      type="button"
      data-open-window="contact"
      class="win31-button-outset active:win31-button-inset inline-block cursor-pointer bg-win-surface px-3 py-0.5 text-xs font-bold text-win-text hover:bg-win-surface-hover sm:px-2 sm:text-[10px]"
    >
      Contact
    </button>
    {icp && (
      <a
        href="https://beian.miit.gov.cn/"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-auto text-[10px] text-win-text/60 no-underline hover:text-win-text sm:text-[8px]"
      >
        {icp}
      </a>
    )}
  </div>
</Window>
