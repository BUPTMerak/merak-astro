---
// Terminal component with Windows 3.1 style window controls
import Window from "./Window.astro";
---

<Window title="C:\\HELLO.EXE">
  <div
    class="bg-black text-green-400 text-sm md:text-xs sm:text-[10px] p-2 md:p-1.5 sm:p-1 h-full overflow-y-auto leading-tight"
  >
    <div class="h-full">
      <div class="m-0 p-0 min-h-[1.2em]">
        <span class="text-yellow-400 font-bold">C:\></span>
        <span class="text-white ml-1">hello.exe</span>
      </div>
      <div class="h-[1.2em]"></div>
      <div class="m-0 p-0 min-h-[1.2em]">
        <pre
          class="text-cyan-400 text-[10px] md:text-[8px] sm:text-[6px] leading-none font-mono whitespace-pre block">
          _______   __    __  _______ ________  __       __                               __       
          |       \ |  \  |  \|       \        \|  \     /  \                             |  \      
          | $$$$$$$\| $$  | $$| $$$$$$$\$$$$$$$$| $$\   /  $$  ______    ______   ______  | $$   __ 
          | $$__/ $$| $$  | $$| $$__/ $$ | $$   | $$$\ /  $$$ /      \  /      \ |      \ | $$  /  \
          | $$    $$| $$  | $$| $$    $$ | $$   | $$$$\  $$$$|  $$$$$$\|  $$$$$$\ \$$$$$$\| $$_/  $$
          | $$$$$$$\| $$  | $$| $$$$$$$  | $$   | $$\$$ $$ $$| $$    $$| $$   \$$/      $$| $$   $$ 
          | $$__/ $$| $$__/ $$| $$       | $$   | $$ \$$$| $$| $$$$$$$$| $$     |  $$$$$$$| $$$$$$\ 
          | $$    $$ \$$    $$| $$       | $$   | $$  \$ | $$ \$$     \| $$      \$$    $$| $$  \$$\
           \$$$$$$$   \$$$$$$  \$$        \$$    \$$      \$$  \$$$$$$$ \$$       \$$$$$$$ \$$   \$$
        </pre>
      </div>
      <div class="h-[1.2em]"></div>
      <div class="m-0 p-0 min-h-[1.2em]">
        <span class="text-green-400">Welcome to the retro terminal!</span>
      </div>
      <div class="m-0 p-0 min-h-[1.2em]">
        <span class="text-green-400">System initialized successfully.</span>
      </div>
      <div class="m-0 p-0 min-h-[1.2em]">
        <span class="text-green-400">Ready for input...</span>
      </div>
      <div class="h-[1.2em]"></div>
      <div class="m-0 p-0 min-h-[1.2em]">
        <span class="text-yellow-400 font-bold">C:\></span>
        <span class="text-green-400 cursor-blink">█</span>
      </div>
    </div>
  </div>
</Window>
