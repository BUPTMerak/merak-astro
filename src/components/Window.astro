---
// Windows 3.1 style window component with title bar and controls
import CloseIcon from "./CloseIcon.astro";
import MaximizeIcon from "./MaximizeIcon.astro";
import MinimizeIcon from "./MinimizeIcon.astro";

export interface Props {
  title?: string;
  class?: string;
}

const { title = "Window", class: className = "" } = Astro.props;
---

<div
  class={`h-full max-w-4xl mx-auto bg-[#c0c0c0] dark:bg-[#505050] border-2 border-[#c0c0c0] dark:border-[#505050] win31-outset dark:win31-outset-dark flex flex-col ${className}`}
>
  <!-- Window Title Bar -->
  <div
    class="flex items-center justify-between border-b border-gray-500 bg-gradient-to-r from-blue-600 to-blue-800 px-0.5 py-0.5 text-[11px] font-bold text-white md:text-[10px] dark:border-gray-600 dark:from-blue-800 dark:to-blue-900"
  >
    <div class="flex-grow px-1.5 py-0.5">{title}</div>
    <div class="flex gap-0.5">
      <button
        class="win31-button-outset dark:win31-button-outset-dark active:win31-button-inset dark:active:win31-button-inset-dark flex h-3.5 w-4 cursor-pointer items-center justify-center bg-[#c0c0c0] p-0 text-[8px] font-bold text-black hover:bg-[#d4d0c8] dark:bg-[#505050] dark:text-white dark:hover:bg-[#606060]"
        aria-label="Minimize"
      >
        <MinimizeIcon />
      </button>
      <button
        class="win31-button-outset dark:win31-button-outset-dark active:win31-button-inset dark:active:win31-button-inset-dark flex h-3.5 w-4 cursor-pointer items-center justify-center bg-[#c0c0c0] p-0 text-[8px] font-bold text-black hover:bg-[#d4d0c8] dark:bg-[#505050] dark:text-white dark:hover:bg-[#606060]"
        aria-label="Maximize"
      >
        <MaximizeIcon />
      </button>
      <button
        class="win31-button-outset dark:win31-button-outset-dark active:win31-button-inset dark:active:win31-button-inset-dark flex h-3.5 w-4 cursor-pointer items-center justify-center bg-[#c0c0c0] p-0 text-[8px] font-bold text-black hover:bg-[#d4d0c8] dark:bg-[#505050] dark:text-white dark:hover:bg-[#606060]"
        aria-label="Close"
      >
        <CloseIcon />
      </button>
    </div>
  </div>

  <!-- Window Content -->
  <div class="flex-grow overflow-hidden">
    <slot />
  </div>
</div>
