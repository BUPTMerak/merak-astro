---
import sphereWide from "@/assets/sphere_wide.png";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
---

<Layout>
  <div class="crt-gpu" data-crt-gpu data-map={sphereWide.src}>
    <canvas
      data-crt-canvas
      role="img"
      aria-label="Merak retro terminal. Use the Home, About, Projects and Contact buttons."
      aria-describedby="crt-help"></canvas>
    <p id="crt-help" class="crt-fallback">
      Merak — Building Things for the Web. A retro-terminal portfolio. Welcome to the retro
      terminal! System initialized successfully. Ready for input. About: Hello! Welcome to my corner
      of the internet. I build things for the web. Projects: Directory of C:\PROJECTS, projects
      coming soon. Contact: get in touch. A standard DOM version is available at /dom.
    </p>
    <div class="crt-fallback">
      <h1>Merak — Building Things for the Web</h1>
      <p>
        A retro-terminal portfolio. I build things for the web — interfaces, tools, and experiments
        that feel alive.
      </p>
      <p>Welcome to the retro terminal! System initialized successfully. Ready for input.</p>
      <p>About: Hello! Welcome to my corner of the internet. I build things for the web.</p>
      <p>Projects: Directory of C:\PROJECTS. Projects coming soon…</p>
      <p>Contact: Get in touch…</p>
    </div>
    <a class="crt-skip" href="/dom">Open the standard DOM version</a>
    <noscript>
      <p class="crt-noscript">
        This WebGL experience needs JavaScript. <a href="/dom">Open the standard version</a>.
      </p>
    </noscript>
  </div>
</Layout>

<style>
  .crt-gpu {
    position: fixed;
    inset: 0;
    overflow: hidden;
  }
  .crt-gpu canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
    outline: none;
  }
  .crt-gpu--failed canvas {
    display: none;
  }
  .crt-gpu--failed .crt-fallback:not(#crt-help) {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
    overflow: visible;
    padding: 2rem;
    color: #111;
    background: #f5f5f5;
  }
  .crt-fallback {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .crt-skip {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 10;
    transform: translateY(-200%);
    padding: 0.5rem 1rem;
    background: #fff;
    color: #000;
    font: 12px / 1.4 monospace;
  }
  .crt-skip:focus {
    transform: none;
  }
  .crt-noscript {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: #000;
    color: #4ade80;
    font: 14px monospace;
  }
</style>

<script>
  import { mountCrt } from "@/gpu/main";
  mountCrt();
</script>
