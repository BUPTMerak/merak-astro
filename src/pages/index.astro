---
import About from "@/components/About.astro";
import CRT from "@/components/CRT.astro";
import NavBar from "@/components/NavBar.astro";
import Terminal from "@/components/Terminal.astro";
import { TesseractWindow } from "@/components/TesseractWindow.tsx";
import Layout from "@/layouts/Layout.astro";
import "@/styles/global.css";
---

<Layout>
  <div class="h-screen w-screen">
    <CRT class="h-full w-full p-4">
      <div data-desktop class="flex h-full flex-col gap-3 md:relative">
        <div data-slot="hello" class="shrink-0">
          <Terminal />
        </div>
        <div data-slot="tesseract" class="min-h-0 flex-1">
          <TesseractWindow client:only="react" />
        </div>
        <div data-slot="nav" class="mt-auto shrink-0 self-center">
          <NavBar />
        </div>

        <template data-window-template="about" data-window-title="C:\ABOUT.EXE">
          <About />
        </template>

        <template data-window-template="projects" data-window-title="C:\PROJECTS.EXE">
          <div
            class="h-full overflow-y-auto bg-white p-2 text-sm leading-tight text-gray-800 sm:p-1 sm:text-[10px] md:p-1.5 md:text-xs dark:bg-black dark:text-green-400"
          >
            <div class="m-0 min-h-[1.2em] p-0">
              <span class="font-bold text-yellow-600 dark:text-yellow-400">C:\&gt;</span>
              <span class="ml-1 text-gray-800 dark:text-white">dir /projects</span>
            </div>
            <div class="h-[1.2em]"></div>
            <div class="m-0 min-h-[1.2em] p-0">
              <span class="text-green-600 dark:text-green-400">Directory of C:\PROJECTS</span>
            </div>
            <div class="m-0 min-h-[1.2em] p-0">
              <span class="text-green-600 dark:text-green-400">Projects coming soon&hellip;</span>
            </div>
          </div>
        </template>

        <template data-window-template="contact" data-window-title="C:\CONTACT.EXE">
          <div
            class="h-full overflow-y-auto bg-white p-2 text-sm leading-tight text-gray-800 sm:p-1 sm:text-[10px] md:p-1.5 md:text-xs dark:bg-black dark:text-green-400"
          >
            <div class="m-0 min-h-[1.2em] p-0">
              <span class="font-bold text-yellow-600 dark:text-yellow-400">C:\&gt;</span>
              <span class="ml-1 text-gray-800 dark:text-white">contact.exe</span>
            </div>
            <div class="h-[1.2em]"></div>
            <div class="m-0 min-h-[1.2em] p-0">
              <span class="text-green-600 dark:text-green-400">Get in touch&hellip;</span>
            </div>
          </div>
        </template>
      </div>
    </CRT>
  </div>
</Layout>

<script>
  import "@/scripts/window-manager";
</script>
